# In den server-Block deiner Domain einfügen (oder als eigenen server-Block).
# Variante A: eigene Subdomain, z. B. assraus.example.ch
server {
    listen 443 ssl;
    http2 on;
    server_name assraus.example.ch;
    # ssl_certificate ... (z. B. von certbot)

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;     # nötig für WebSocket (/ws)
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 1h;
    }
}

# Variante B: Unterpfad einer bestehenden Seite, z. B. https://example.ch/assraus/
